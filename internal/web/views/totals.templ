package views

import "github.com/el/family-habit-tracker/internal/service"

// Totals is the family's lifetime record: one card per person, spanning every
// sprint they have ever taken part in.
templ Totals(page Page, totals []service.PersonTotals) {
	@Layout(page) {
		<div class="ht-wide ht-stack">
			<h2 class="ht-section-title">Lifetime totals</h2>
			if len(totals) == 0 {
				@EmptyState("No data yet", "Add your family in Settings and the first ticks will show up here.") {
					<a class="ht-btn ht-btn-terracotta" href="/settings?tab=people">Go to Settings</a>
				}
			} else {
				<div class="ht-cards">
					for _, person := range totals {
						<article class="ht-progress-card">
							<h3 class="ht-section-title" style="font-size:24px">{ person.Person.Name }</h3>
							<div class="ht-stat-row ht-divider">
								<div>
									<div class="ht-num">{ itoa(person.TicksEarned) }</div>
									<div class="ht-eyebrow">Points</div>
								</div>
								<div>
									<div class="ht-num">{ itoa(person.RewardsAchieved) }</div>
									<div class="ht-eyebrow">Rewards</div>
								</div>
								<div>
									<div class="ht-num">{ itoa(person.SprintCount) }</div>
									<div class="ht-eyebrow">Sprints</div>
								</div>
							</div>
							<div class="ht-divider" style="margin-top:12px;padding-top:12px">
								if person.ActiveReward != nil {
									<div class="ht-note">{ TotalsSavingText(person) }</div>
									<div class="ht-progress-track" style="margin-top:8px">
										<div
											class="ht-progress-fill"
											style={ widthStyle(percentOf(person.CurrentBalance, person.ActiveReward.Cost)) }
										></div>
									</div>
								} else {
									<div class="ht-note">{ TotalsSavingText(person) }</div>
								}
							</div>
						</article>
					}
				</div>
			}
		</div>
	}
}
