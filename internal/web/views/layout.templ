package views

// Layout is the document shell every page renders inside: the newspaper
// masthead, the primary nav, the page body, and the family footer.
templ Layout(page Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#fbf8f2"/>
			<title>{ page.documentTitle() }</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/static/favicon.svg"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Noto+Sans+SC:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
			/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<a class="ht-skip" href="#main">Skip to the ledger</a>
			<div class="ht-root">
				<div class="ht-shell">
					<div class="ht-page">
						@masthead(page)
						<main id="main" class="ht-main">
							{ children... }
						</main>
						@footer()
					</div>
				</div>
			</div>
			<div id="celebration"></div>
			<div id="ht-toasts" class="ht-toasts" aria-live="polite"></div>
			for _, flash := range page.Flashes {
				<span data-flash={ flash.Message } data-flash-type={ flash.Type } hidden></span>
			}
		</body>
	</html>
}

// masthead prints the title block: edition number and nav on the left, the
// Chinese masthead in the centre, the sprint's dates on the right.
templ masthead(page Page) {
	<header class="ht-masthead">
		<div class="ht-mast-left">
			<div class="ht-eyebrow">{ page.editionText() }</div>
			<nav class="ht-nav" aria-label="Primary">
				for _, item := range navItems {
					<a
						class="ht-nav-link"
						href={ templ.SafeURL(item.Href) }
						data-active={ boolAttr(page.isActive(item)) }
						if page.isActive(item) {
							aria-current="page"
						}
					>
						{ item.Label }
					</a>
				}
			</nav>
		</div>
		<div class="ht-mast-center">
			<h1 class="ht-mast-title">家庭习惯表</h1>
			<div class="ht-mast-sub">A Family Habit Tracker · one small tick at a time</div>
		</div>
		<div class="ht-mast-right">
			<div class="ht-mast-dates">
				if page.Sprint != nil {
					<div class="ht-eyebrow"><b>Begins</b> &nbsp; { FormatLong(page.Sprint.StartDate) }</div>
					<div class="ht-eyebrow"><b>Ends</b> &nbsp;&nbsp;&nbsp; { FormatLong(page.Sprint.EndDate) }</div>
					if page.Sprint.IsArchived() {
						<div class="ht-mast-flag">Archived</div>
					}
				} else {
					<div class="ht-note">No active sprint</div>
				}
			</div>
		</div>
	</header>
}

// footer carries the house rules that make the shared tablet work.
templ footer() {
	<footer class="ht-footer">
		<div>
			<h4>A note for the family · 家人的话</h4>
			<p>
				The habits above were chosen by each of us, for ourselves. We cheer each
				other on, but the ticks belong to the person whose name is on the row.
				Be kind. Be consistent. A ninety-percent month beats a perfect week.
			</p>
		</div>
		<div>
			<h4>The shared tablet · 共用平板</h4>
			<p>
				Anyone in the family can walk up and tap their own ticks. Trust is the
				model. The reward is the goal.
			</p>
		</div>
		<div class="ht-footer-brand">
			<span class="ht-footer-mark">家</span>
			<span class="ht-note">Family Habit Tracker · { Year() }</span>
		</div>
	</footer>
}
