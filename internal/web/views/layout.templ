package views

import "github.com/el/family-habit-tracker/internal/service"

// Layout is the document shell every page renders inside: the masthead with
// its nav, the page body, and the family footer.
//
// Chinese text uses the device's own fonts (PingFang, Noto CJK, YaHei), which
// every phone and tablet already has; only the Latin serif and Inter load.
templ Layout(page Page) {
	<!DOCTYPE html>
	<html lang="zh-Hans">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#fbf8f2"/>
			<title>{ page.documentTitle() }</title>
			<link rel="icon" href={ asset("favicon.svg") } type="image/svg+xml"/>
			<link rel="apple-touch-icon" href={ asset("favicon.svg") }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@500;600&display=swap"
			/>
			<link rel="stylesheet" href={ asset("app.css") }/>
			<script src={ asset("htmx.min.js") } defer></script>
			<script src={ asset("app.js") } defer></script>
		</head>
		<body>
			<a class="ht-skip" href="#main">Skip to the page</a>
			<div class="ht-page">
				@masthead(page)
				<main id="main" class="ht-main">
					{ children... }
				</main>
				@footer()
			</div>
			<div id="celebration"></div>
			<div id="ht-toasts" class="ht-toasts" aria-live="polite"></div>
			for _, flash := range page.Flashes {
				<span data-flash={ flash.Message } data-flash-type={ flash.Type } hidden></span>
			}
		</body>
	</html>
}

// masthead prints the title and the three ways around the app.
templ masthead(page Page) {
	<header class="ht-mast">
		<a class="ht-mast-title" href={ templ.SafeURL(page.todayHref()) }>家庭习惯表</a>
		<span class="ht-mast-sub">one small tick at a time</span>
		<nav class="ht-nav" aria-label="Primary">
			@navLink("Today", page.todayHref(), page.Section == SectionToday)
			@navLink("History", page.historyHref(), page.Section == SectionHistory)
			@navLink("Family", "/family", page.Section == SectionFamily)
		</nav>
	</header>
}

templ navLink(label, href string, active bool) {
	<a
		class="ht-nav-link"
		href={ templ.SafeURL(href) }
		data-active={ boolAttr(active) }
		if active {
			aria-current="page"
		}
	>{ label }</a>
}

// FamilyStrip is the row of names at the top of a person's pages: one tap
// switches person, and each name shows how far they are today. It is swapped
// on its own after a tick so the counts stay true.
templ FamilyStrip(entries []service.StripEntry, selected int64, href func(int64) string, oob bool) {
	<nav
		class="ht-strip"
		id="strip"
		aria-label="Family"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, entry := range entries {
			<a
				href={ templ.SafeURL(href(entry.Person.ID)) }
				data-active={ boolAttr(entry.Person.ID == selected) }
				data-all-done={ boolAttr(entry.AllDone()) }
				if entry.Person.ID == selected {
					aria-current="page"
				}
			>
				<span class="ht-strip-name">{ entry.Person.Name }</span>
				<span class="ht-strip-count">{ stripCount(entry) }</span>
			</a>
		}
	</nav>
}

// footer carries the house rules that make the shared tablet work.
templ footer() {
	<footer class="ht-footer">
		<p>
			Each of us chose our habits for ourselves. We cheer each other on, but the
			ticks belong to the person whose name is on the page. Be kind. Be consistent.
		</p>
		<p class="ht-footer-brand"><span>家</span> Family Habit Tracker · { itoa(Year()) }</p>
	</footer>
}
