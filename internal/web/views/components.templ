package views

import "github.com/el/family-habit-tracker/internal/domain"

// EmptyState is the placeholder shown where there is nothing yet to display.
templ EmptyState(title, description string) {
	<div class="ht-empty">
		<h3>{ title }</h3>
		<p>{ description }</p>
		{ children... }
	</div>
}

// Modal is a dismissible dialog. It starts hidden and is opened by any control
// carrying data-modal-open with this id.
templ Modal(id, title string) {
	<div class="ht-modal" id={ id } hidden role="dialog" aria-modal="true" aria-labelledby={ id + "-title" }>
		<div class="ht-modal-card">
			<h2 class="ht-modal-title" id={ id + "-title" }>{ title }</h2>
			{ children... }
		</div>
	</div>
}

// ConfirmButton pairs a trigger with a confirmation dialog that posts to a
// URL. Used for anything that takes something off a list, so nothing on the
// shared tablet is one stray tap away from changing.
templ ConfirmButton(id, label, title, body, cta, action string) {
	<button type="button" class="ht-btn-line ht-btn-danger" data-modal-open={ id }>{ label }</button>
	@Modal(id, title) {
		<p class="ht-modal-body">{ body }</p>
		<form method="post" action={ templ.SafeURL(action) } class="ht-modal-actions">
			<button type="button" class="ht-btn ht-btn-ghost" data-modal-close>Cancel</button>
			<button type="submit" class="ht-btn ht-btn-danger">{ cta }</button>
		</form>
	}
}

// DeductModal is the points dialog behind a person's "− deduct" link.
//
// It takes a positive number of points and the server records it as a negative
// adjustment, so the person operating the tablet never has to think in signs.
templ DeductModal(person domain.Person) {
	@Modal("deduct", "Deduct points · "+person.Name) {
		<form method="post" action={ templ.SafeURL(PersonHref(person.ID) + "/adjustments") }>
			<label class="ht-field">
				<span class="ht-label">Points to deduct</span>
				<input class="ht-input" type="number" name="points" value="1" min="1" max="9999" required inputmode="numeric"/>
			</label>
			<label class="ht-field">
				<span class="ht-label">Reason (optional)</span>
				<input class="ht-input" type="text" name="reason" maxlength="120" placeholder="e.g. missed bedtime"/>
			</label>
			<div class="ht-modal-actions">
				<button type="button" class="ht-btn ht-btn-ghost" data-modal-close>Cancel</button>
				<button type="submit" class="ht-btn ht-btn-danger">Deduct</button>
			</div>
		</form>
	}
}

// Celebration is the full-screen moment when someone reaches their goal. It is
// delivered as an out-of-band swap on the tick that earns the reward, so it
// appears without a page reload.
templ Celebration(person domain.Person, reward domain.Reward) {
	<div id="celebration" hx-swap-oob="true">
		<div class="ht-modal" role="dialog" aria-modal="true" aria-labelledby="celebration-title">
			<div class="ht-modal-card ht-celebration">
				<div class="ht-eyebrow ht-accent">Goal hit · 达成</div>
				<h2 class="ht-celebration-name" id="celebration-title">{ person.Name }</h2>
				<p class="ht-celebration-line">earned <b>{ reward.Name }</b></p>
				<p class="ht-note">Leftover points roll into the next goal.</p>
				<div class="ht-modal-actions ht-modal-actions-center">
					<a class="ht-btn ht-btn-accent" href={ templ.SafeURL(EditHref(person.ID) + "#goal") }>Pick next goal</a>
					<button type="button" class="ht-btn ht-btn-ghost" data-modal-close>Maybe later</button>
				</div>
			</div>
		</div>
	</div>
}

// ClearCelebration empties the celebration slot on a tick that earns nothing,
// so a dialog from an earlier tick does not linger.
templ ClearCelebration() {
	<div id="celebration" hx-swap-oob="true"></div>
}

// GoalForm sets a person's next goal.
templ GoalForm(person domain.Person) {
	<form class="ht-goal-form" method="post" action={ templ.SafeURL(PersonHref(person.ID) + "/goal") } id="goal">
		<label class="ht-field ht-grow">
			<span class="ht-label">Next goal</span>
			<input class="ht-input" type="text" name="name" maxlength="80" required placeholder="e.g. Lego Batman car"/>
		</label>
		<label class="ht-field ht-cost">
			<span class="ht-label">Points</span>
			<input class="ht-input" type="number" name="cost" min="1" max="9999" required inputmode="numeric"/>
		</label>
		<button type="submit" class="ht-btn ht-btn-accent">Set goal</button>
	</form>
}
